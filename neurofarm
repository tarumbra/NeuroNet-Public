#!/bin/bash
# neurofarm -- open the NeuroFarm game (its own window).
#
#     neurofarm             open it, or bring the open one here (the app icon)
#     neurofarm toggle      the same, but if it's already on this workspace,
#                           tuck it away (Super+Alt+Y -- like NeuroNet's key)
#     neurofarm start       start it hidden if it isn't running
#
# There is only ever one NeuroFarm (neurofarm.py refuses a second and brings
# the first forward), so two windows can never save over each other. Tucked
# away, it waits in a Hyprland scratchpad ("special:neurofarm"). Crops grow by
# the clock, so the farm catches up whenever it opens. (2026-10-07)
set -u
APP_DIR="$(dirname "$(readlink -f "$0")")"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/neuronet/neurofarm.log"
SPECIAL="neurofarm"
mkdir -p "$(dirname "$LOG")"
action="${1:-show}"

dsp() { hyprctl dispatch "$1" >/dev/null 2>&1; }
owned() {
  busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus \
    NameHasOwner s org.neurofarm.App 2>/dev/null | grep -q true
}
bus() { busctl --user call org.neurofarm.App /org/neurofarm/App org.neurofarm.App "$1" >/dev/null 2>&1; }
win_json() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl clients -j 2>/dev/null | jq -c '[.[] | select(.class == "NeuroFarm" or .initialClass == "NeuroFarm")][0] // empty'
}
launch() {
  local run=(python3 "$APP_DIR/neurofarm.py" --gui qt "$@")
  if command -v uwsm-app >/dev/null 2>&1; then run=(uwsm-app -- "${run[@]}"); fi
  cd "$APP_DIR" && setsid -f "${run[@]}" >"$LOG" 2>&1
}

# bring it to the workspace in front of you, or (toggle) tuck it away if it's already there
here() {
  local may_hide="$1" j addr ws target win
  if ! owned; then launch; return; fi
  # Without Hyprland (KDE Plasma, 2026-10-14): the game shows and hides its own
  # window (Show/Hide/State) and neuronet-raise asks KWin to bring it forward.
  if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    local state
    state=$(busctl --user call org.neurofarm.App /org/neurofarm/App org.neurofarm.App State 2>/dev/null | sed -E 's/^s "(.*)"$/\1/')
    if [ "$may_hide" = yes ] && [ -n "$state" ] && [ "$state" != hidden ]; then bus Hide; return; fi
    bus Show
    "$APP_DIR/neuronet-raise" NeuroFarm
    return
  fi
  j="$(win_json)"
  if [ -z "$j" ]; then bus Show; return; fi            # running hidden: show it
  addr=$(jq -r .address <<<"$j"); ws=$(jq -r .workspace.name <<<"$j")
  target=$(hyprctl activeworkspace -j | jq -r .name)
  win="address:$addr"
  if [ "$may_hide" = yes ] && [ "$ws" = "$target" ]; then
    dsp "hl.dsp.window.move({ window = \"$win\", workspace = \"special:$SPECIAL\", follow = false })"
    return
  fi
  [ "$ws" != "$target" ] && dsp "hl.dsp.window.move({ window = \"$win\", workspace = \"$target\" })"
  dsp "hl.dsp.focus({ window = \"$win\" })"
}

case "$action" in
  show|"") here no ;;
  toggle)  here yes ;;
  start)   owned || launch --hidden ;;
  *) echo "Usage: neurofarm [show|toggle|start]" >&2; exit 2 ;;
esac
