[Unit]
Description=NeuroNet: watch NeuroStream's music library, the recipes and notes vault for the Omarchy menu

[Path]
PathChanged=%h/.local/share/neurostream/music/library.json
PathChanged=@DATA@/kitchen/cookery.json
PathModified=@DATA@/notes/vault
Unit=neuronet-menu.service
TriggerLimitIntervalSec=30
TriggerLimitBurst=4

[Install]
WantedBy=default.target
