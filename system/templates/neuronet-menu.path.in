[Unit]
Description=NeuroNet: watch the music library, recipes and notes vault for the Omarchy menu

[Path]
PathChanged=@DATA@/chords/chords.json
PathChanged=@DATA@/kitchen/cookery.json
PathModified=@DATA@/notes/vault
Unit=neuronet-menu.service
TriggerLimitIntervalSec=30
TriggerLimitBurst=4

[Install]
WantedBy=default.target
