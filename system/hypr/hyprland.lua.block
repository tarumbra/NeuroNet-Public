-- >>> NeuroNet desktop integration (install.sh)
-- Added by the NeuroNet migration; see QUICK-ACCESS.md in the NeuroNet folder.
-- Only the main window (titled NeuroNet): its file pickers open in front, where Cam is.
o.window({ class = "^(NeuroNet|neuronet[.]py)$", title = "^NeuroNet$" }, { workspace = "special:neuronet silent", float = true })
-- Glowing window borders in every theme, when NeuroNet's Settings -> Appearance has them on (window_glow.py).
do local f = os.getenv("HOME") .. "/.local/state/neuronet/glow.lua"; local h = io.open(f, "r"); if h then h:close(); dofile(f) end end -- NeuroNet glow
-- <<< NeuroNet desktop integration (install.sh)
