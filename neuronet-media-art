#!/usr/bin/env python3
"""neuronet-media-art -- cover pictures onto Media (15 November 2026).

Cam: "Media Art (this is where i can put pictures of DVD, VHS, Vinyl, CD and
more covers. Then you can action them and place them into the application for
me on the respective film. If the film isnt in neuronet then you can add them
into the media list as well as place the respective picture. This will help
speed up data entry."

    neuronet-media-art folder           print the Media Art folder
    neuronet-media-art list             the pictures waiting in it
    neuronet-media-art apply PICTURE --title "Practical Magic" [--type film]
                         [--format DVD] [--year 1998] [--creator "..."] [--keep]

Claude looks at each picture, works out what it is (title, year, artist for
music) and what it's on (DVD, Blu-ray, VHS, CD, Vinyl, Cassette ...), then
runs `apply`: NeuroNet finds that item in Media, or adds it, tags the format,
and puts the picture into Photos -> Covers and onto it (media.cover, SS.Shelf
in ui/stuff/shelf.js). The picture then moves into Media Art/Archive
(--keep leaves it where it is).
"""
import argparse
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import snips  # noqa: E402

TYPES = ("film", "music", "book", "game", "other")


def call_app(action, payload):
    caller = os.environ.get("NEURONET_SNIP_CALL") or os.path.join(HERE, "neuronet-call")   # tests: a stand-in
    try:
        r = subprocess.run([caller, action, json.dumps(payload)], capture_output=True, text=True, timeout=90)
        return json.loads(r.stdout.strip().splitlines()[-1]) if r.stdout.strip() else {"error": "NeuroNet did not answer."}
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return {"error": "NeuroNet did not answer."}


def main(argv):
    ap = argparse.ArgumentParser(prog="neuronet-media-art", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("folder")
    sub.add_parser("list")
    a = sub.add_parser("apply")
    a.add_argument("picture")
    a.add_argument("--title", required=True)
    a.add_argument("--type", default="film", choices=TYPES)
    a.add_argument("--format", default="")
    a.add_argument("--year", default="")
    a.add_argument("--creator", default="")
    a.add_argument("--keep", action="store_true")
    args = ap.parse_args(argv)
    if args.cmd == "folder":
        print(snips.media_art_dir())
        return 0
    if args.cmd == "list" or not args.cmd:
        for p in snips.media_art_waiting():
            print(p)
        return 0
    pic = os.path.abspath(args.picture)
    if not os.path.isfile(pic):
        print("No picture at %s" % pic, file=sys.stderr)
        return 1
    res = call_app("media.cover", {"path": pic, "title": args.title, "type": args.type, "format": args.format,
                                   "year": args.year, "creator": args.creator})
    if not res.get("ok"):
        print("Not done: %s" % res.get("error", "no answer"), file=sys.stderr)
        return 1
    where = "" if args.keep else snips.media_art_archive(pic)
    print("%s %s (%s%s)%s" % ("Added" if res.get("added") else "Cover set on", res.get("title"), res.get("type"),
                               ", " + ", ".join(res.get("formats") or []) if res.get("formats") else "",
                               " -> " + where if where else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
