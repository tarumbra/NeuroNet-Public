[Unit]
Description=NeuroNet: watch the music library, recipes and notes vault for the Omarchy menu

[Path]
PathChanged=/home/tarumbra/DataDrive/NeuroNet/neuronet_data/chords/chords.json
PathChanged=/home/tarumbra/DataDrive/NeuroNet/neuronet_data/kitchen/cookery.json
PathModified=/home/tarumbra/DataDrive/NeuroNet/neuronet_data/notes/vault
Unit=neuronet-menu.service
TriggerLimitIntervalSec=30
TriggerLimitBurst=4

[Install]
WantedBy=default.target
