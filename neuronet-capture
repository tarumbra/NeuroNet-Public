#!/bin/bash
# neuronet-capture -- Super+Alt+X and the Omarchy menu's capture rows.
#
# Since 15 November 2026 a capture is a NeuroNet snip (neuronet-snip): Omarchy's
# own screenshot tool (omasnap: smart selection, preview, pin, copy, edit),
# with what it saves named "YYMMDD - Snip N" and kept in ~/Documents/NeuroNet
# Snips and in Photos, folder "NeuroNet Snips". Cam: "implement a snip feature
# that lives within NeuroNet so i can stop using the screen shot tool."
#
#     neuronet-capture              smart: drag a box, click a window, or click
#                                   empty space for the screen
#     neuronet-capture region | windows | fullscreen | scroll
set -u
exec "$(dirname "$(readlink -f "$0")")/neuronet-snip" "${1:-smart}"
