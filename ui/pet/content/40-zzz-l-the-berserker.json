 "FURY": {
  "//": "The Berserker's meter (Battle Re-work Part 5; Cam's brief: fury builds as you deal and take damage, and empties after a fight). Each round you fight: perRound, plus deal x (your damage / the creature's health), plus take x (the damage you took / your max health) -- all x (1 + Seething), take x (1 + Pain feeds). The Berserker's specials are paid in fury, not the special bar.",
  "classes": [
   "berserker"
  ],
  "perRound": 2,
  "deal": 40,
  "take": 60,
  "max": 100
 },
 "BLOODLUST": {
  "//": "The Berserker's only heal, earned in the fight: a blow, and for rounds rounds after, heal heal x the damage you deal (Bloodletter: more). From class level minLevel.",
  "name": "Bloodlust",
  "cost": 80,
  "dmg": 1,
  "rounds": 3,
  "heal": 0.2,
  "minLevel": 25,
  "about": "Your next blow, and the 3 rounds after it: you heal for 20% of the damage you deal. 80 fury."
 }
