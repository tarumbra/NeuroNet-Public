 "BEAST_FIGHT": {
  "//": "The Beast Master's fight (note 06). fight: a pet's attack = level x attLevel + its Attack x attStat; defence the same; max hit = hitBase + (level + Attack) / hitDiv; dodge = Speed x dodgePerSpeed (up to dodgeMax). front: the share of the creature's blows at your front pet (the rest at a random other). pack: pets in a fight to start (Bond adds); bench: more you can swap in. xpShare: each pet's share of a kill's xp by how many fought. foodCut: food heals pets 20% less. regen: a share of its health a pet heals a minute between fights. die: in these modes, beyond the early grounds (level above safeTo), the chance a fainting pet dies (Q11). startMoves: moves a pet knows when it joins; slots: moves it uses.",
  "fight": {
   "attLevel": 1,
   "attStat": 2,
   "defLevel": 1,
   "defStat": 2,
   "hitBase": 2,
   "hitDiv": 4,
   "dodgePerSpeed": 0.004,
   "dodgeMax": 0.3
  },
  "front": 0.7,
  "pack": 1,
  "bench": 2,
  "xpShare": [
   1,
   0.6,
   0.5
  ],
  "foodCut": 0.8,
  "regen": 0.02,
  "die": {
   "hardcore": 0.1,
   "hell": 0.25
  },
  "safeTo": 18,
  "startMoves": 2,
  "slots": 4
 },
