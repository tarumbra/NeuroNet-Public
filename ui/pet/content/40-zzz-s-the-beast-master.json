 "BEAST_PP": {
  "//": "V5 (2026-10-17, Cam's PT17 note: 'should their be a PP system similar to pokemon ... Once all PP is exhausted there will be a default attack which will continue infinetly'). Every move has PP by kind -- the 9 strong ones (their old '2 a fight' limit) few, everyday hits many; a use spends one, and they carry from fight to fight through a hunt. A win gives `regen` back to every move (a breather); the pack coming home from a hunt, or resting in the Pen, fills them; a Pet tonic fills one pet's. Out of PP, a pet uses Scrap (never runs out). The Mathematician: a pack makes ~1,250 moves an hour, so pools are per hunt with the breather -- a pet leaning on one move runs it down and must use the others; Scrap fills the gaps. The talent that gave limited moves more uses gives them more PP (+2 a rank).",
  "strong": 6,
  "big": 14,
  "hit": 24,
  "status": 12,
  "heal": 8,
  "bigPower": 1.5,
  "regen": 2,
  "talentPP": 2,
  "scrap": {
   "name": "Scrap",
   "power": 0.6,
   "about": "A tired, scrappy swipe -- never runs out."
  },
  "tonic": {
   "item": {
    "name": "Pet tonic",
    "gem": 3,
    "about": "Fills a battle pet's PP: in a hunt (the fight's Feed menu), and a pet down to Scrap drinks one between fights on its own.",
    "price": 30
   },
   "recipe": {
    "make": "pettonic",
    "needs": {
     "chamomile": 2,
     "honey": 1
    },
    "level": 12,
    "xp": 28
   }
  }
 }
